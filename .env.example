# MongoDB connection string (e.g. mongodb://localhost:27017/nexus_cms or mongodb+srv://...)
DATABASE_URL=mongodb+srv://Adeeb-01:adeeb7067@learning-db.dlk5z.mongodb.net/CMS?appName=learning-db
# JWT signing secret (use any random string)
SESSION_SECRET=super-secret-dev-key-change-me-in-production

# Node Environment
NODE_ENV=development

# Port configuration
PORT=8080
BASE_PATH=/

# Firebase Admin (required for FCM push when app is closed)
# Download service account JSON from Firebase Console → Project Settings → Service accounts
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Frontend (artifacts/cms-app/.env) — copy from artifacts/cms-app/.env.example
# VITE_API_BASE_URL=http://localhost:8080
# VITE_APP_NAME=CMS
# VITE_APP_SHORT_NAME=CMS
# VITE_APP_LOGO=/logo.png

# Frontend Firebase vars go in artifacts/cms-app/.env (VITE_FIREBASE_*)

# Object storage (DigitalOcean Spaces / S3-compatible) — used for uploads when set
# If omitted, files are stored locally under artifacts/api-server/uploads/
LINODE_OBJECT_BUCKET=
LINODE_OBJECT_STORAGE_REGION=sgp1
LINODE_OBJECT_STORAGE_ENDPOINT=https://sgp1.digitaloceanspaces.com
LINODE_OBJECT_STORAGE_ACCESS_KEY_ID=
LINODE_OBJECT_STORAGE_SECRET_ACCESS_KEY=
# Prefix inside the bucket (e.g. ClientManagement-CMS/)
BUCKET_FOLDER_PATH=ClientManagement-CMS/
# Optional override for public file URLs (CDN/custom domain)
# OBJECT_STORAGE_PUBLIC_URL=https://your-bucket.sgp1.digitaloceanspaces.com
