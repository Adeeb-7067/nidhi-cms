# =============================================================================
# .graphifyignore — Content-Management-Hub (frontend/ + backend/)
# Excludes generated code, dependencies, build output, and local caches.
# =============================================================================

# ---- Dependencies & package manager ----------------------------------------
node_modules/
**/node_modules/
.pnpm-store/
.pnp.*
.yarn/

# ---- Lockfiles -------------------------------------------------------------
pnpm-lock.yaml
package-lock.json
yarn.lock
**/pnpm-lock.yaml
**/package-lock.json
**/yarn.lock

# ---- Build / dist / cache outputs ------------------------------------------
dist/
build/
out/
.next/
.vite/
.turbo/
.cache/
**/dist/
**/build/
**/out/
**/.next/
**/.vite/
**/.turbo/
**/.cache/
**/coverage/
**/*.tsbuildinfo

# ---- Auto-generated API types (use openapi.yaml as source of truth) --------
backend/src/api-zod/generated/
frontend/src/api/generated/
**/generated/

# ---- Local runtime data / uploads ------------------------------------------
uploads/
**/uploads/

# ---- Cursor / agent / IDE workspace data -----------------------------------
.cursor/
agent-transcripts/
terminals/
.vscode/
.idea/
.code-review-graph/

# ---- Environment & secrets -------------------------------------------------
.env
.env.*
**/.env
**/.env.*

# ---- Logs & temp files -----------------------------------------------------
*.log
**/*.log
*.tmp
**/*.tmp
*.pid

# ---- Source maps & minified assets -----------------------------------------
*.map
**/*.map
*.min.js
*.min.css
**/*.min.js
**/*.min.css

# ---- Test snapshots --------------------------------------------------------
**/__snapshots__/
**/*.snap

# ---- Binary / media ----------------------------------------------------------
*.mp4
*.mov
*.mp3
*.wav
*.zip
*.tar
*.tar.gz
*.7z
*.apk
*.ipa
*.exe
*.dll
*.so
*.dylib
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.svg
*.ico
*.pdf

# ---- Graphify local-only metadata ------------------------------------------
graphify-out/manifest.json
graphify-out/cost.json
graphify-out/cache/
**/graphify-out/manifest.json
**/graphify-out/cost.json
**/graphify-out/cache/

# ---- Misc ------------------------------------------------------------------
.DS_Store
Thumbs.db
*.bak
*.orig
