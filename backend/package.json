{
  "name": "cms-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon",
    "dev:once": "npm run build && npm run start",
    "build": "node ./build.mjs",
    "start": "node --env-file=.env --enable-source-maps ./dist/index.mjs",
    "seed": "node ./scripts/run-bundled.mjs seed",
    "seed-more": "node ./scripts/run-bundled.mjs seed-more",
    "migrate-company": "node ./scripts/run-bundled.mjs migrate-company-hierarchy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1048.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^8.5.1",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.12.1",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.7",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "puppeteer": "^24.43.1",
    "socket.io": "^4.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.0.0",
    "thread-stream": "3.1.0"
  }
