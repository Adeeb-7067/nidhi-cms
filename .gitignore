# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# Environment & secrets — never commit (any package or depth)
.env
.env.*
.env.example
.envrc

# Keys and credential files
*.pem
*.key
*-credentials.json
credentials.json
service-account*.json
firebase-adminsdk*.json
secrets/

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

private-uploads/
uploads/


# Local MongoDB data (dev)
.mongo-data/
.mongo-log/

# Electron build output
electron/dist-electron/
electron/graphify-out/

# Nested reference repo (separate git checkout)
HRM Satyakabir/

# Graphify — repo root graph only; per-app copies are local noise
frontend/graphify-out/
backend/graphify-out/

# Backend is JavaScript-only — ignore stray TypeScript if recreated locally
backend/**/*.ts
graphify-out/manifest.json
graphify-out/cost.json
graphify-out/cache/
# Added by code-review-graph
.code-review-graph/
