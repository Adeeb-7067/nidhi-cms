<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Required by Electron's V8 JIT engine under Hardened Runtime -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Required for Electron's internal use of unsigned executable memory -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Required for Electron to load dynamic libraries from the app bundle -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <!-- Required for desktopCapturer (screen recording via macOS TCC) -->
    <key>com.apple.security.device.screen-capture</key>
    <true/>
  </dict>
</plist>
