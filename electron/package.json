{
  "name": "cms-desktop",
  "version": "1.0.0",
  "description": "CMS Desktop — native wrapper for Content Management Hub",
  "main": "main.js",
  "scripts": {
    "dev": "node launch.js",
    "build:frontend": "node scripts/write-api-config.js && npm run build:electron --prefix ../frontend",
    "build": "node scripts/write-api-config.js && npm run build:frontend && electron-builder",
    "build:win": "node scripts/write-api-config.js && npm run build:frontend && electron-builder --win",
    "build:mac": "node scripts/write-api-config.js && npm run build:frontend && electron-builder --mac",
    "build:linux": "node scripts/write-api-config.js && npm run build:frontend && electron-builder --linux",
    "write-api-config": "node scripts/write-api-config.js",
    "test:blur": "node sensitive-apps.test.js"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.contentmanagementhub.cms",
    "productName": "CMS Desktop",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "dist-electron",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "sensitive-apps.js",
      "screenshot-blur.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist/electron",
        "to": "frontend/dist/electron",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "assets",
        "to": "electron/assets",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "signAndEditExecutable": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Office"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "Adeeb-7067",
      "repo": "Content-Management-Hub"
    }
  }
}
