# CMS frontend (Vite) — copy to artifacts/cms-app/.env
VITE_API_BASE_URL=http://localhost:8080

# Project branding
VITE_APP_NAME=CMS
VITE_APP_SHORT_NAME=CMS
VITE_APP_LOGO=/logo.png
VITE_APP_DESCRIPTION=Content management, project workflow, and team collaboration platform.
VITE_APP_COPYRIGHT=© 2026 CMS. All rights reserved.

# Firebase (optional — push notifications)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_VAPID_KEY=
